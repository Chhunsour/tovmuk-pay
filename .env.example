# Copy to .env.local for local development. Never commit real values.

# ABA PayWay credentials (issued by the examiners)
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Sandbox QR demo. Use http://localhost:4010 with `pnpm mock` for local mock runs.
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# ABA-generated QR; status is verified by Check transaction without a custom callback.
PAYWAY_SANDBOX_QR=1

# Public origin used to build the callback, return and cancel URLs we sign
APP_BASE_URL=http://localhost:3000

# Supabase (server-side only; the browser never talks to the database)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
