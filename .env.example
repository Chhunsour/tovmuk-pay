# Copy to .env.local for local development. Never commit real values.

# ABA PayWay credentials (issued by the examiners)
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Optional. Defaults to https://checkout.payway.com.kh (production).
# Use http://localhost:4010 with `pnpm mock` for local end-to-end runs.
PAYWAY_BASE_URL=

# Public origin used to build the callback, return and cancel URLs we sign
APP_BASE_URL=http://localhost:3000

# Supabase (server-side only; the browser never talks to the database)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
